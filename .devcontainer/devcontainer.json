{
  // VS Code : "Dev Containers: Reopen in Container"
  // Démarre postgres + mlflow + dev, puis ouvre VS Code dans le conteneur "dev".
  "name": "Smart City AI (dev)",
  "dockerComposeFile": ["../docker-compose.yml"],
  "service": "dev",
  "runServices": ["postgres", "mlflow", "dev"],
  "workspaceFolder": "/workspace",
  "remoteUser": "dev",
  // Laisser MLflow et PostgreSQL tourner quand VS Code se ferme
  "shutdownAction": "none",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true
        }
      }
    }
  }
}
