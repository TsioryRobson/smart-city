# Variables d'environnement de docker-compose.yml : modèle à copier.
#   cp .env.example .env   puis remplacer chaque valeur « changeme ».
# Le fichier .env n'est JAMAIS versionné (voir .gitignore).
# Mots de passe : lettres et chiffres seulement (ils figurent dans une URI).
#   Exemple pour en générer un : openssl rand -hex 24

# --- PostgreSQL (métadonnées MLflow) -----------------------------------------
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mlflow
# Port de PostgreSQL sur la machine (outil SQL). Changer si 5432 est déjà pris.
POSTGRES_HOST_PORT=5432

# --- MinIO (artefacts MLflow) ------------------------------------------------
MINIO_ROOT_USER=novaria
MINIO_ROOT_PASSWORD=changeme
MLFLOW_BUCKET=mlflow
# Bucket des données du projet et compte MinIO du pipeline Kubeflow
# (accès limité à ce bucket : voir infra/minio/setup_pipeline_access.py).
NOVARIA_DATA_BUCKET=novaria-data
MINIO_PIPELINE_USER=novaria-pipeline
MINIO_PIPELINE_PASSWORD=changeme

# --- Scripts du pipeline (hors Docker) ---------------------------------------
# À exporter dans le terminal pour suivre les runs sur le serveur :
#   export MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_TRACKING_URI=http://localhost:5000
