# =============================================================================
# Variables d'environnement - modèle à copier :  cp .env.example .env
# Le fichier .env n'est JAMAIS versionné (voir .gitignore).
# Changez tous les mots de passe avant le premier démarrage.
# =============================================================================

# --- Administrateur PostgreSQL --------------------------------------------
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change_me_admin

# --- Base MLflow (métadonnées des expériences et du Registry) -------------
MLFLOW_DB_NAME=mlflow
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=change_me_mlflow

# --- Base applicative Urban Hub (mesures, prédictions, alertes) -----------
APP_DB_NAME=urbanhub
APP_DB_USER=urbanhub
APP_DB_PASSWORD=change_me_urbanhub

# --- Serveur MLflow : en-têtes Host acceptés -------------------------------
MLFLOW_ALLOWED_HOSTS=mlflow,mlflow:5000,localhost,localhost:*,127.0.0.1,127.0.0.1:*,host.docker.internal,host.docker.internal:*
